{
  "name": "cinelogplay",
  "version": "1.0.0",
  "description": "CinelogPlay - Catálogo Informativo de Produções Cinematográficas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm -C frontend run dev",
    "build": "pnpm -C frontend run build",
    "preview": "pnpm -C frontend run preview",
    "test:ci": "pnpm -C frontend run test:ci",
    "cypress:open": "pnpm -C frontend run cypress:open",
    "backend:dev": "pnpm -C backend run dev",
    "backend:start": "pnpm -C backend run start",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "keywords": [
    "cinema",
    "catalogo",
    "filmes"
  ],
  "author": "CinelogPlay Team",
  "license": "MIT"
}
