###############################################
# TEMPLATE DE CONFIGURAÇÃO DA EQUIPE - MODELO PARA O TIME SEGUIR
# Este arquivo é versionado no repositório
# Use como base para criar o .env local
###############################################

###############################################
# PORTA DA API
###############################################
PORT=3001

###############################################
# REGRAS DE CONFIGURAÇÃO
###############################################
# .env → ambiente REAL (local ou produção)
# .env.example → modelo para equipe seguir, sem dados sensíveis
# Docker → usa nome do serviço (postgres)
# Local → usa localhost

###############################################
# BANCO DE DADOS - PADRÃO (DOCKER)
###############################################
# Este é o padrão recomendado para o projeto, usando Docker
# O DB_HOST=postgres é o nome do serviço no docker-compose.yml

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=senha_segura
DB_NAME=CinelogPlay

###############################################
# CORS - PERMITIR REQUISIÇÕES DO FRONTEND
###############################################
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

###############################################
# NODE ENVIRONMENT
###############################################
NODE_ENV=development

###############################################
# ALTERNATIVA (LOCAL SEM DOCKER)
###############################################
# Caso alguém não use Docker e tenha o PostgreSQL instalado localmente:
# DESCOMENTE abaixo e COMENTE o bloco Docker acima
#
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=Devops_Programacao_2026P2
# DB_NAME=CinelogPlay

###############################################
# PRODUÇÃO (SUPABASE)
###############################################
# Substituir pelos dados reais do Supabase quando deployar
# NÃO usar localhost aqui fará a aplicação quebrar em produção
#
# DB_HOST=db.xxxxx.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=senha_real
# DB_NAME=postgres

###############################################
# INSTRUÇÕES PARA A EQUIPE
###############################################
# 1. Copiar este arquivo:
#    cp backend/.env.example backend/.env
#
# 2. Ajustar conforme seu ambiente:
#    - Docker → manter DB_HOST=postgres
#    - Local → usar DB_HOST=localhost
#
# 3. NUNCA subir o .env para o GitHub
#    (Já está no .gitignore)